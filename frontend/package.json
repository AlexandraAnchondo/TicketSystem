{
  "name": "frontendVite",
  "version": "0.1.0",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "electron": "electron .",
    "electron-dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.alex.tickets",
    "productName": "Sistema Tickets",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/src",
        "to": "backend/src"
      },
      {
        "from": "../backend/package.json",
        "to": "backend/package.json"
      },
      {
        "from": "../backend/.env",
        "to": "backend/.env"
      },
      {
        "from": "../backend/node_modules",
        "to": "backend/node_modules"
      }
    ],
    "asar": false,
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "@emotion/react": "^11",
    "@emotion/styled": "^11",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@mui/icons-material": "^7",
    "@mui/material": "^7",
    "@mui/material-nextjs": "^7",
    "@react-pdf/renderer": "^4.3.0",
    "@toolpad/core": "0.16.0",
    "axios": "^1.10.0",
    "framer-motion": "^12.23.26",
    "html5-qrcode": "^2.3.8",
    "qrcode.react": "^4.2.0",
    "react": "^19",
    "react-dom": "^19",
    "react-router": "^7",
    "react-router-dom": "^7.8.2",
    "styled-components": "^6.1.19",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^8.2.2",
    "electron": "^42.3.2",
    "electron-builder": "^26.8.1",
    "electron-is-dev": "^3.0.1",
    "eslint": "^8",
    "typescript": "^5",
    "vite": "^5.4.8",
    "wait-on": "^7.2.0"
  }
}
